# Optional hosted LLM provider. Leave the key blank for offline-only operation.
GROQ_API_KEY=
# Answer-generation model.
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
# Intent-routing model.
GROQ_ROUTER_MODEL=llama-3.3-70b-versatile
# Compatibility model names used by older bounded generation paths.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Optional adjudicator model; defaults to the router model when blank.
GROQ_ADJUDICATION_MODEL=
# Maximum structured-output budget for provider calls.
GROQ_STRUCTURED_MAX_TOKENS=1200
# Bounded adjudication timeout.
GROQ_ADJUDICATION_TIMEOUT_SECONDS=3
# Enable only where provider-backed adjudication is explicitly intended.
LLM_ADJUDICATION_ENABLED=true
# Internal evaluation judge; disabled for normal runtime and offline CI.
LLM_JUDGE_ENABLED=false

# Optional local app settings
APP_ENV=development
ENVIRONMENT=development
ALLOW_DEMO_AUTH=false
# Synthetic-data boundary. This repository must remain synthetic-only.
NLCARE_SYNTHETIC_ONLY=true
NLCARE_BOOTSTRAP_SYNTHETIC_DEMO=false
NLCARE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8017,http://127.0.0.1:8017
DATABASE_URL=sqlite:///./medical_agent.db
SQLITE_TIMEOUT_SECONDS=30
NLCARE_PATIENT_ENRICHMENT_PREWARM_ENABLED=true
NLCARE_PATIENT_ENRICHMENT_PREWARM_PATIENT_IDS=P001,P002
NLCARE_PATIENT_ENRICHMENT_PREWARM_LIMIT=2
NLCARE_PATIENT_REPORT_CACHE_TTL_SECONDS=900
NLCARE_PATIENT_CORE_CACHE_TTL_SECONDS=120
NLCARE_ENRICHMENT_WORKERS=1
# Structured JSON event-log severity.
NLCARE_LOG_LEVEL=INFO
# Severity for the root logger, which carries framework and third-party output.
# Set separately from NLCARE_LOG_LEVEL so application events can run at INFO
# without library chatter at the same level. Only applied when the root logger
# has no handlers of its own.
NLCARE_ROOT_LOG_LEVEL=WARNING
# Maximum accepted request body size in bytes.
NLCARE_MAX_REQUEST_BYTES=10485760
# Process-local/shared limiter window and endpoint budgets.
NLCARE_RATE_WINDOW_SECONDS=60
NLCARE_AUTH_RATE_LIMIT=20
NLCARE_CHAT_RATE_LIMIT=30
NLCARE_UPLOAD_RATE_LIMIT=10
# API URL used by smoke scripts, not by the backend itself.
API_BASE_URL=http://127.0.0.1:8017

# Docker Compose overrides DATABASE_URL with Postgres automatically.
# For manual Postgres runs:
# DATABASE_URL=postgresql+psycopg2://medical_agent:medical_agent@127.0.0.1:5432/medical_agent
REDIS_URL=redis://127.0.0.1:6379/0
# Use the shared Redis limiter for any multi-process synthetic deployment.
# Strict staging/production profiles fail closed when it is enabled but Redis
# is unavailable. Local single-process development may leave it disabled.
NLCARE_SHARED_RATE_LIMIT_ENABLED=false
NLCARE_PLATFORM_JOB_RATE_LIMIT=60
NLCARE_PLATFORM_WRITE_RATE_LIMIT=30
# The SaaS worker always supports dry-run previews. Keep real allowlisted
# commands disabled unless a restricted synthetic operator explicitly enables them.
NLCARE_SAAS_JOB_EXECUTION_ENABLED=false

# Optional RAG reranking. Disabled by default because first run downloads a model.
RAG_ENABLE_CROSS_ENCODER=false
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Fail readiness when a deployment promises dense retrieval but the runtime
# only has the sparse TF-IDF/BM25 fallback. Keep false for the lightweight
# disposable demo; production profiles set this to true.
NLCARE_RAG_REQUIRE_DENSE=false
# Use a deployment-specific path so runtimes with different serializer and
# retrieval dependencies never overwrite one another's persisted index.
NLCARE_RAG_INDEX_PATH=Data/rag_index/local_hybrid_rag_index.joblib
# Warm the local retrieval runtime during application startup.
NLCARE_RAG_PREWARM=true
# Candidate limits used before fusion and optional cross-encoding.
RAG_RRF_CANDIDATE_LIMIT=50
RAG_CROSS_ENCODER_CANDIDATE_LIMIT=20
# Sparse TF-IDF/BM25 retrieval only; no embedding model is loaded. Used for
# controlled ablation, and the setting that makes retrieval fully offline: with
# it unset, the dense hybrid index loads sentence-transformers/all-MiniLM-L6-v2
# on first build or query, and no provisioning step fetches that model. Pytest
# and every CI job set this to true.
RAG_FORCE_SPARSE=false

# Managed vector stores are shadow candidates only. The live patient route
# remains local FAISS + BM25 + RRF until a frozen parity evaluation supports
# promotion. Never place patient IDs, raw chat, or PHI in these indexes.
NLCARE_VECTOR_BACKEND=local_faiss
NLCARE_MANAGED_VECTOR_SHADOW_ENABLED=false
NLCARE_MANAGED_VECTOR_ALLOW_NETWORK=false
NLCARE_VECTOR_DIMENSION=384

# Optional Azure AI Search shadow adapter. Prefer a short-lived Entra bearer
# token from managed identity. The API-key field exists only for compatibility
# with an externally managed dev service; the checked-in Bicep disables local
# authentication.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_API_VERSION=2026-04-01
AZURE_SEARCH_NAMESPACE=nlcare_kb_demo_t1_t3
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_BEARER_TOKEN=

# Optional Pinecone shadow adapter.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=nlcare-kb-shadow
PINECONE_NAMESPACE_KB=nlcare_kb_demo_t1_t3
PINECONE_API_VERSION=2025-10

# Optional MLflow mirroring. The local JSON/DB registry works without MLflow.
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=file:./Data/mlruns_mlflow

# Optional local Ollama fallback/learning sandbox.
# Groq is primary when GROQ_API_KEY is set; Ollama is for local experiments or fallback only.
# Leave OLLAMA_MODEL blank to skip Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=3
OLLAMA_STRUCTURED_MAX_TOKENS=1200
LOCAL_LLM_MODEL=

# LLM reliability and cost telemetry. Prices are engineering estimates only.
NLCARE_LLM_CIRCUIT_FAILURE_THRESHOLD=3
NLCARE_LLM_CIRCUIT_COOLDOWN_SECONDS=30
NLCARE_LLM_AUTH_CIRCUIT_COOLDOWN_SECONDS=300
NLCARE_LLM_INPUT_COST_PER_MILLION_USD=0
NLCARE_LLM_OUTPUT_COST_PER_MILLION_USD=0

# Optional LLM-backed clinical-summary wording. Disabled by default.
CLINICAL_SUMMARY_ENABLE_LLM=false
CLINICAL_SUMMARY_LLM_TIMEOUT_SECONDS=3

# Experimental workflows remain shadowed or disabled by default.
NLCARE_AGENTIC_SHADOW_ENABLED=false
NLCARE_AUTOMATION_EXECUTION_ENABLED=false
NLCARE_FINETUNE_EXPERIMENT_ENABLED=false
NLCARE_SEMANTIC_SAFETY_ENABLED=true
NLCARE_HIGH_RISK_SEMANTIC_VALIDATION_REQUIRED=true
NLCARE_DEP001B_SAFETY_ENABLED=true
NLCARE_DEP001D_OUTPUT_GUARD_ENABLED=true

# Optional redacted internal notification automation. Disabled by default.
# Connect the imported high_risk_review_alert workflow to approved email,
# SMS, or Viber nodes inside n8n; never put patient identity or raw chat here.
N8N_WEBHOOK_DISPATCH_ENABLED=false
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook/nlcare
N8N_WEBHOOK_SIGNING_SECRET=replace_with_a_long_random_secret
NLCARE_ALERT_NOTIFICATION_MAX_ATTEMPTS=3
NLCARE_ALERT_NOTIFICATION_RETRY_BASE_SECONDS=30
NLCARE_ALERT_TEST_RECIPIENT_ONLY=true

# Internal CI and evaluation paths. Do not point these at final/consumed banks
# during ordinary development. Official one-shot protocols own their lifecycle.
NLCARE_DEP001A_ARTIFACT_DIR=Data/evals/safety/dep001a
NLCARE_DEP001B_ARTIFACT_DIR=Data/evals/safety/dep001b
NLCARE_DEP001D_ARTIFACT_DIR=Data/evals/safety/dep001d
NLCARE_BURNED_DEP001_EXTERNAL_PATH=
NLCARE_SHIP_STEP_TIMEOUT_SECONDS=1800
SMOKE_PATIENT_ID=P001

# Library noise controls for CI/offline benchmark processes.
HF_HUB_DISABLE_PROGRESS_BARS=1
TOKENIZERS_PARALLELISM=false
TQDM_DISABLE=1

# Deprecated compatibility variables. New deployments should use NLCARE_*.
ONCOTRACK_CORS_ORIGINS=
ONCOTRACK_FAST_MODE=false
ONCOTRACK_NLI_ALLOW_DOWNLOAD=false
ONCOTRACK_POSTGEN_ANSWER_ESCALATION=false
ONCOTRACK_RAG_CLAIM_VALIDATOR=heuristic
ONCOTRACK_RAG_JUDGE=false
ONCOTRACK_RAG_JUDGE_MODEL=
ONCOTRACK_RELEASE_ID=

# Test-execution environment.
#
# Pytest forces NLCARE_TEST_OFFLINE=true for the default suite. That mode strips
# live credentials, disables model downloads, and blocks every non-loopback DNS
# or socket attempt. External integration tests must use the explicit
# `@pytest.mark.requires_network` marker and are deselected by default.
NLCARE_TEST_OFFLINE=false
#
# PYTEST_CURRENT_TEST is set and cleared by pytest itself for each test; you do
# not set it. It is listed here because application code reads it: the API skips
# RAG index prewarming when it is present, so a test run does not pay for - or
# depend on - a background warm-up. Leave it empty outside pytest.
PYTEST_CURRENT_TEST=

# Never commit real API keys or patient data.
